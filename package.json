{
  "name": "slides",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "main": "src/index.md",
  "scripts": {
    "dev": "marp -s src",
    "build:clean": "rimraf dist",
    "build:html": "marp",
    "build:ogimage": "marp --image jpeg --allow-local-files",
    "build:assets": "cpx \"src/**/images/**/*\" dist",
    "build": "pnpm run build:clean && pnpm run build:html && pnpm run build:ogimage && pnpm run build:assets",
    "cf:dev": "wrangler dev",
    "cf:deploy": "pnpm run build && wrangler deploy",
    "new:slide": "plop slide"
  },
  "engines": {
    "node": "22.x"
  },
  "author": "",
  "devDependencies": {
    "@marp-team/marp-cli": "^4.3.1",
    "cpx2": "^8.0.2",
    "plop": "^4.0.5",
    "rimraf": "^6.1.3",
    "wrangler": "^4.83.0"
  }
}
